# Dependencies
node_modules

# Build output
dist
dist-ssr

# Logs
*.log
npm-debug.log*

# Environment — never commit real values; .env.example is the template.
.env
.env.local
.env.*.local

# Runtime data: the store (menu, rooms, bookings, users) and uploaded media.
# Not source — back these up, do not commit them.
server/data/
server/data.*/

# Derived by `npm run images`; regenerated automatically before dev/build.
client/src/assets/images/generated/

# Generated by `npm run seo` from the router's route list and page data.
client/public/sitemap.xml
client/public/robots.txt
client/public/llms.txt

# Editors / OS
.DS_Store
.vite
*.local
.idea
.vscode/*
!.vscode/extensions.json
.vercel
.env*
