# Copy to .env and adjust. ADMIN_PASSWORD and SMTP_URL are secrets; .env is
# gitignored.

# ───────────────────────────── server ─────────────────────────────
# Set to production on the live server: secure cookies, HSTS, no internal
# error text, and the startup checks below.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Serve the built front end from this process as well as the API.
# Set false to run the API alone behind a separate static host.
SERVE_CLIENT=true

# Where `npm run build` leaves the front end. Defaults to client/dist.
# CLIENT_DIR=/srv/hillsedge/client/dist

# Where the built admin panel is. Served at /admin. Defaults to admin/dist.
# ADMIN_DIR=/srv/hillsedge/admin/dist

# Everything the admin manages (menu, rooms, bookings, content, users) lives in
# one JSON file, and uploads in one folder. Both MUST be on a volume that
# survives a redeploy, and both are what you back up.
# DATA_FILE=/var/lib/hillsedge/store.json
# UPLOADS_DIR=/var/lib/hillsedge/uploads

# The first super admin, created on first boot when no users exist. In
# development, leaving these unset creates admin@hillsedge.local with a
# generated password printed to the log. Remove them once you have signed in.
# ADMIN_EMAIL=owner@hillsedgeberagala.com
# ADMIN_PASSWORD=at-least-ten-characters
# ADMIN_NAME=Owner

# How long an admin stays signed in without activity.
SESSION_TTL_HOURS=12

# The restaurant's timezone — what "today" means for bookings and offers.
TIMEZONE=Asia/Colombo

# Outgoing mail for password resets and new-booking alerts. Unset, mail is
# printed to the log instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Hillsedge Beragala <no-reply@hillsedgeberagala.com>"
# BOOKING_ALERT_TO=reservations@hillsedgeberagala.com
# The site's public https origin. REQUIRED in production — the server will
# not start without it. Password-reset links are built from this, never from
# the request, so a forged Host header cannot redirect a real reset token.
# PUBLIC_ORIGIN=https://hillsedgeberagala.com

# Upload ceilings, in MB.
MAX_IMAGE_MB=15
MAX_VIDEO_MB=120

# Bookings from before the store existed (JSON Lines). Imported once, on the
# first boot that creates the store; never written to again.
# RESERVATIONS_FILE=/var/lib/hillsedge/reservations.jsonl

# Booking attempts allowed per address per window, and failed sign-ins.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=10

# Number of proxies in front of this process (nginx, Cloudflare, a platform
# router). Leave 0 if it is directly exposed: trusting a forwarded header
# nobody set lets a client spoof its address and evade the rate limiter.
# Behind the nginx block in docs/DEPLOYMENT.md this must be 1. The server
# warns in its log if it sees a proxy header while this is 0.
TRUST_PROXY=0

# ───────────────────────────── client ─────────────────────────────
# Only needed if the front end is served from a different origin to the API.
# Left empty, the app calls /api on its own origin.
# VITE_API_BASE_URL=https://api.hillsedgeberagala.com

# Where `npm run dev` proxies /api during development.
# VITE_DEV_API_TARGET=http://localhost:4000
